---
import BaseLayout from '../layouts/base-layout.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import ContactForm from '../components/ContactForm.tsx';
import BorderGlow from '../components/BorderGlow.tsx';
import { personal, skills, projects, contact } from '../data/portfolio';
---

<BaseLayout title={`${personal.name} | ${personal.role}`}>
  <section id="inicio" class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-20 h-72 w-72 -translate-x-1/2 rounded-full bg-violet-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute right-10 top-64 hidden h-52 w-52 rounded-full bg-cyan-400/10 blur-3xl lg:block"></div>
    <div class="text-center px-6">
      <div class="mb-6 flex flex-wrap justify-center gap-3">
        <span class="badge">DAW recién titulado</span>
        <span class="badge">Disponible junior</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-black leading-tight tracking-tight themed-heading">
        Hola, soy 
        <span 
          class="bg-clip-text text-transparent"
          style={{ backgroundImage: 'linear-gradient(135deg, #8B5CF6, #EC4899)' }}
        >
          {personal.name}
        </span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg md:text-xl themed-text">
        {personal.role}
      </p>
      <p class="mt-4 max-w-xl mx-auto themed-muted">
        {personal.tagline}
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row justify-center">
        <a href="#proyectos" class="btn-primary">
          Ver proyectos
        </a>
        <a href="#contacto" class="btn-secondary">
          Contacto
        </a>
        <a href="/Currículum.pdf" download class="btn-secondary">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Descargar CV
        </a>
      </div>
      <div class="mt-16 animate-bounce">
        <a href="#sobre-mi" class="themed-muted hover:themed-text transition-colors duration-200" aria-label="Ir abajo">
          <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section id="sobre-mi" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="text-sm font-bold uppercase tracking-widest text-pink-400 mb-2">Sobre mí</p>
    <h2 class="text-3xl md:text-5xl font-black themed-heading mb-6 bg-gradient-to-r from-violet-500 to-pink-500 bg-clip-text text-transparent">
      Perfil Junior con actitud y base técnica.
    </h2>
    
    <!-- Grid de 2 columnas para biografía + (lo que busco / cómo trabajo) -->
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <!-- Columna izquierda: biografía -->
      <div class="space-y-4">
        {personal.bio.map((paragraph) => (
          <p class="themed-text leading-relaxed">{paragraph}</p>
        ))}
        <div class="pt-4 flex gap-4">
          <!-- iconos de redes -->
        </div>
      </div>
      
      <!-- Columna derecha: dos tarjetas en vertical -->
      <div class="grid gap-4">
        <BorderGlow client:visible>
          <div class="p-6 h-full"> <!-- añadido h-full -->
            <h3 class="text-xl font-black themed-heading mb-3">Lo que busco</h3>
            <p class="themed-text leading-relaxed">Quiero mi primera oportunidad en el mundo del desarrollo web. Estoy preparado para trabajar en equipo, enfrentarme a retos reales y seguir formándome cada día con proyectos que aporten valor.</p>
          </div>
        </BorderGlow>
        <BorderGlow client:visible>
          <div class="p-6 h-full"> <!-- añadido h-full -->
            <h3 class="text-xl font-black themed-heading mb-3">Cómo trabajo</h3>
            <p class="themed-text leading-relaxed">Mi enfoque es ordenado y metódico: primero entender el problema, luego dividirlo, documentar cada paso y dejar el código limpio para que el equipo pueda iterar sin fricciones.</p>
          </div>
        </BorderGlow>
      </div>
    </div> <!-- fin del grid de 2 columnas -->
    
    <!-- Ahora Tecnologías va FUERA del grid, pero debajo, ocupando todo el ancho -->
    <div class="mt-12"> <!-- margen superior para separar -->
      <BorderGlow client:visible>
        <div class="p-6">
          <h3 class="text-xl font-black themed-heading mb-4">Tecnologías</h3>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="project-tech-tag">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      </BorderGlow>
    </div>
  </div>
</section>

  <section id="proyectos" class="py-24">
    <div class="mx-auto max-w-5xl px-6">
      <p class="text-sm font-bold uppercase tracking-widest text-pink-400 mb-2">Proyectos</p>
      <h2 class="text-3xl md:text-5xl font-black themed-heading mb-6">Proyectos que muestran lo que sé hacer.</h2>
      <p class="themed-muted mb-12 max-w-2xl">Cada proyecto demuestra un lado distinto de mi formacion — desde APIs hasta interfaces, pasando por despliegue.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project, i) => (
          <ProjectCard client:visible project={project} index={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="contact-card relative overflow-hidden rounded-3xl p-8 sm:p-12">
        <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-cyan-400/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -left-20 -bottom-20 h-64 w-64 rounded-full bg-violet-500/15 blur-3xl"></div>
        <div class="relative z-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-widest text-pink-400 mb-2">Contacto</p>
            <h2 class="text-3xl md:text-4xl font-black themed-heading mb-4">¿Buscas a alguien con ganas de crecer y aportar? </h2>
            <p class="themed-muted">Tengo la base técnica, el interés por backend y despliegue, y muchas ganas de demostrar lo que valgo. Escríbeme y hablemos."</p>
          </div>
          <ContactForm client:only="react" />
        </div>
      </div>
    </div>
  </section>

  <footer class="border-t themed-border py-8">
    <div class="mx-auto max-w-5xl px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm themed-muted">
        &copy; {new Date().getFullYear()} {personal.name}. Hecho con Astro, Tailwind CSS, React y TypeScript.
      </p>
      <div class="flex gap-4">
        <a href={contact.github} target="_blank" rel="noopener noreferrer" class="themed-muted hover:themed-text transition-colors duration-200 text-sm">GitHub</a>
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="themed-muted hover:themed-text transition-colors duration-200 text-sm">LinkedIn</a>
        <a href={`mailto:${contact.email}`} class="themed-muted hover:themed-text transition-colors duration-200 text-sm">Email</a>
      </div>
    </div>
  </footer>
</BaseLayout>